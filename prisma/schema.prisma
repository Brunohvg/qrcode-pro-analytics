generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  CANCELED
  EXPIRED
  PAST_DUE
}

enum DeviceType {
  IOS
  ANDROID
  DESKTOP
}

enum NotificationType {
  SCAN_MILESTONE
  SYSTEM
}

enum BillingProvider {
  MERCADO_PAGO
  MANUAL_PIX
  ADMIN
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELED
  REFUNDED
  IN_REVIEW
}

enum BillingCycle {
  MONTHLY
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  password      String
  role          UserRole       @default(USER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  qrCodes       QRCode[]
  subscriptions Subscription[]
  campaigns     Campaign[]
  notifications Notification[]
  customDomains CustomDomain[]
  apiKeys       ApiKey[]
  webhooks      Webhook[]
  integration   Integration?
  payments      Payment[]

  @@index([createdAt])
}

model Plan {
  id                 String         @id @default(cuid())
  name               String         @unique
  qrLimit            Int
  dynamicLinks       Boolean        @default(false)
  price              Decimal        @default(0) @db.Decimal(10, 2)
  analyticsDays      Int            @default(7)
  customBranding     Boolean        @default(false)
  campaigns          Boolean        @default(false)
  scheduledLinks     Boolean        @default(false)
  passwordProtection Boolean        @default(false)
  reports            Boolean        @default(false)
  bulkGeneration     Boolean        @default(false)
  smartRedirect      Boolean        @default(false)
  customDomains      Boolean        @default(false)
  integrations       Boolean        @default(false)
  apiAccess          Boolean        @default(false)
  webhooks           Boolean        @default(false)
  teamSeats          Int            @default(1)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  subscriptions      Subscription[]
  payments           Payment[]
}

model Subscription {
  id                     String             @id @default(cuid())
  userId                 String
  planId                 String
  status                 SubscriptionStatus @default(ACTIVE)
  activeUntil            DateTime?
  provider               BillingProvider?
  providerSubscriptionId String?            @unique
  externalReference      String?            @unique
  billingCycle           BillingCycle       @default(MONTHLY)
  checkoutUrl            String?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  graceUntil             DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                   Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments               Payment[]

  @@index([userId])
  @@index([planId])
  @@index([status])
  @@index([userId, status])
  @@index([provider, status])
}

model Payment {
  id                String          @id @default(cuid())
  userId            String
  planId            String
  subscriptionId    String?
  provider          BillingProvider
  providerPaymentId String?         @unique
  externalReference String
  status            PaymentStatus   @default(PENDING)
  providerStatus    String?
  method            String?
  amount            Decimal         @db.Decimal(10, 2)
  currency          String          @default("BRL")
  description       String?
  dueAt             DateTime?
  paidAt            DateTime?
  reviewedAt        DateTime?
  reviewNote        String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan              Plan            @relation(fields: [planId], references: [id], onDelete: Restrict)
  subscription      Subscription?   @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([externalReference])
  @@index([subscriptionId])
  @@index([status, createdAt])
  @@index([provider, status])
}

model BillingSettings {
  id                    String   @id @default("default")
  mercadoPagoEnabled    Boolean  @default(true)
  manualPixEnabled      Boolean  @default(false)
  pixKey                String?
  pixKeyType            String?
  pixRecipientName      String?
  pixCity               String?
  manualPixInstructions String?
  gracePeriodDays       Int      @default(3)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model BillingWebhookEvent {
  id              String          @id @default(cuid())
  provider        BillingProvider
  providerEventId String          @unique
  eventType       String
  resourceId      String?
  payload         Json
  processedAt     DateTime?
  createdAt       DateTime        @default(now())

  @@index([provider, createdAt])
  @@index([processedAt])
}

model Campaign {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String   @default("#34d399")
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  qrCodes     QRCode[]

  @@index([userId])
  @@index([userId, createdAt])
}

model QRCode {
  id                  String        @id @default(cuid())
  name                String
  originalUrl         String
  slug                String        @unique
  userId              String
  campaignId          String?
  customDomainId      String?
  scanCount           Int           @default(0)
  utmSource           String?
  utmMedium           String?
  utmCampaign         String?
  activeFrom          DateTime?
  expiresAt           DateTime?
  fallbackUrl         String?
  passwordHash        String?
  passwordPrompt      String?
  iosUrl              String?
  androidUrl          String?
  desktopUrl          String?
  countryRules        Json?
  notifyAtScans       Int?
  lastNotifiedAtCount Int           @default(0)
  foregroundColor     String        @default("#07111f")
  accentColor         String        @default("#34d399")
  frameTitle          String?
  frameText           String?
  brandName           String?
  logoUrl             String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign            Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  customDomain        CustomDomain? @relation(fields: [customDomainId], references: [id], onDelete: SetNull)
  scanMetrics         ScanMetric[]
  notifications       Notification[]

  @@index([userId])
  @@index([userId, createdAt])
  @@index([scanCount])
  @@index([campaignId])
  @@index([customDomainId])
}

model ScanMetric {
  id        String     @id @default(cuid())
  qrCodeId  String
  device    DeviceType
  country   String     @default("Unknown")
  browser   String     @default("Unknown")
  scannedAt DateTime   @default(now())
  qrCode    QRCode     @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)

  @@index([qrCodeId])
  @@index([scannedAt])
  @@index([device])
  @@index([country])
  @@index([qrCodeId, scannedAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  qrCodeId  String?
  type      NotificationType @default(SYSTEM)
  title     String
  message   String
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  qrCode    QRCode?          @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([qrCodeId])
}

model CustomDomain {
  id                String    @id @default(cuid())
  userId            String
  host              String    @unique
  verificationToken String
  verifiedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  qrCodes           QRCode[]

  @@index([userId])
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  prefix     String    @unique
  secretHash String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, revokedAt])
}

model Webhook {
  id              String   @id @default(cuid())
  userId          String
  name            String
  url             String
  secretEncrypted String
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, active])
}

model Integration {
  id                       String   @id @default(cuid())
  userId                   String   @unique
  gaMeasurementId          String?
  gaApiSecretEncrypted     String?
  metaPixelId              String?
  metaAccessTokenEncrypted String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
